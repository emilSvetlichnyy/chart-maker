  "comparisons": [
    {
      "id": "pie-vs-bar",
      "slug": "pie-vs-bar",
      "a": "pie",
      "b": "bar",
      "title": "Pie Chart vs Bar Chart",
      "quickAnswer": "Use a pie chart for parts of one whole with few categories. Use a bar chart to compare magnitudes across categories, especially when labels are many or values are close.",
      "decisionRule": "If categories must sum to 100% and you have 3–6 slices, prefer pie (or donut). If you need ranking or precise comparison, prefer bar.",
      "table": [
        ["Job", "Pie", "Bar"],
        ["Part-to-whole", "Strong", "Possible with care"],
        ["Compare magnitudes", "Weak when close", "Strong"],
        ["Many categories", "Poor", "Good"],
        ["Time trends", "Poor", "Fair (line often better)"]
      ]
    },
    {
      "id": "bar-vs-line",
      "slug": "bar-vs-line",
      "a": "bar",
      "b": "line",
      "title": "Bar Chart vs Line Chart",
      "quickAnswer": "Use bars for discrete category comparison. Use lines when values are ordered—usually over time—and you care about direction and rate of change.",
      "decisionRule": "Ask whether the X dimension is categorical (bar) or sequential/temporal (line).",
      "table": [
        ["Job", "Bar", "Line"],
        ["Category ranking", "Strong", "Weak"],
        ["Trend over time", "Fair", "Strong"],
        ["Rate of change", "Weak", "Strong"],
        ["Sparse categories", "Strong", "Can mislead if connected"]
      ]
    },
    {
      "id": "line-vs-area",
      "slug": "line-vs-area",
      "a": "line",
      "b": "area",
      "title": "Line Chart vs Area Chart",
      "quickAnswer": "Both show trends. A line emphasizes path and slope; an area chart fills under the line to emphasize magnitude and volume of change.",
      "decisionRule": "Prefer line for clarity with multiple series; prefer area for a single series where filled volume aids storytelling.",
      "table": [
        ["Job", "Line", "Area"],
        ["Trend clarity", "Strong", "Strong"],
        ["Emphasize volume", "Weak", "Strong"],
        ["Multiple series", "Better", "Can obscure"],
        ["Part-to-whole", "No", "No (unless stacked context)"]
      ]
    },
    {
      "id": "bar-vs-horizontal-bar",
      "slug": "bar-vs-horizontal-bar",
      "a": "bar",
      "b": "horizontalBar",
      "title": "Bar Chart vs Horizontal Bar Chart",
      "quickAnswer": "Vertical bars are familiar for short labels. Horizontal bars (H. Bar in VIA) win when category names are long or you want an easy ranked list.",
      "decisionRule": "If labels wrap or truncate, switch to horizontal bars.",
      "table": [
        ["Job", "Bar (vertical)", "H. Bar"],
        ["Short labels", "Strong", "Strong"],
        ["Long labels", "Weak", "Strong"],
        ["Ranking lists", "Good", "Excellent"],
        ["Time on X", "Common", "Less common"]
      ]
    },
    {
      "id": "pie-vs-donut",
      "slug": "pie-vs-donut",
      "a": "pie",
      "b": "donut",
      "title": "Pie Chart vs Donut Chart",
      "quickAnswer": "They encode the same part-to-whole data. A donut opens the center for a total or label; choose based on layout, not a different analysis.",
      "decisionRule": "Same data rules as pie. Pick donut when a center KPI helps; otherwise either works.",
      "table": [
        ["Job", "Pie", "Donut"],
        ["Part-to-whole", "Strong", "Strong"],
        ["Center KPI", "Weak", "Strong"],
        ["Slice comparison", "Similar", "Similar"],
        ["Many slices", "Poor", "Poor"]
      ]
    },
    {
      "id": "radar-vs-bar",
      "slug": "radar-vs-bar",
      "a": "radar",
      "b": "bar",
      "title": "Radar Chart vs Bar Chart",
      "quickAnswer": "Radar shows a multi-attribute profile as a shape. Bars rank magnitudes clearly. Prefer bars for precise comparison; radar for holistic profile shape.",
      "decisionRule": "If readers must compare exact values, use bars. If the story is the overall pattern across attributes, radar can help.",
      "table": [
        ["Job", "Radar", "Bar"],
        ["Multi-attribute profile", "Strong", "Fair"],
        ["Exact ranking", "Weak", "Strong"],
        ["Many attributes", "Poor", "Good"],
        ["Part-to-whole", "No", "Possible"]
      ]
    }
  ],
  "glossary": [
    {"term": "Chart", "slug": "chart", "definition": "A visual representation of data using position, length, angle, area, or color."},
    {"term": "Graph", "slug": "graph", "definition": "In everyday use, often synonymous with chart. In mathematics, a graph can also mean nodes and edges—different from a data chart."},
    {"term": "Legend", "slug": "legend", "definition": "A key mapping colors or symbols to categories."},
    {"term": "Axis", "slug": "axis", "definition": "A scaled reference line for plotted values."},
    {"term": "Series", "slug": "series", "definition": "A set of related values. VIA supports one flat series of points."},
    {"term": "Data point", "slug": "data-point", "definition": "One observation: typically a label plus numeric value (and X or dates for some types)."},
    {"term": "Part-to-whole", "slug": "part-to-whole", "definition": "A relationship where categories sum to a single total—classic pie/donut job."},
    {"term": "Correlation", "slug": "correlation", "definition": "A relationship between two variables visible on a scatter plot; not proof of causation."},
    {"term": "Export", "slug": "export", "definition": "Saving a chart image or PDF for sharing. VIA supports PNG, JPEG, and PDF."},
    {"term": "Baseline", "slug": "baseline", "definition": "The zero (or reference) line bars are measured from. Truncating it can exaggerate differences."}
  ],
